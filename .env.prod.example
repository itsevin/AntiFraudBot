# =============================================================================
# AntiFraudBot production configuration template
# Copy to .env.prod and replace every value marked CHANGE_ME.
# Never commit .env.prod or any real credential.
# =============================================================================

# NoneBot ---------------------------------------------------------------------
SUPERUSERS=[]
COMMAND_START=[""]
SESSION_EXPIRE_TIMEOUT=00:03:00
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8080

# Web dashboard ---------------------------------------------------------------
# The dashboard binds to localhost by default. Put a reverse proxy in front of
# it for public deployments.
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_ADMIN_PASSWORD=CHANGE_ME_USE_AT_LEAST_12_CHARACTERS
WEB_CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
JWT_EXPIRE_MINUTES=1440
# Optional. When omitted, a random secret is stored in data/.jwt_secret.
# JWT_SECRET=CHANGE_ME_RANDOM_SECRET

# Scheduled content -----------------------------------------------------------
ANTI_FRAUD_KNOWLEDGE_PUSH_HOUR=12
ANTI_FRAUD_KNOWLEDGE_PUSH_MINUTE=0
ANTI_FRAUD_EXAMPLE_PUSH_HOUR=12
ANTI_FRAUD_EXAMPLE_PUSH_MINUTE=0

# Alibaba Cloud URL moderation (optional) -------------------------------------
ALIBABA_CLOUD_ACESS_KEY_ID=
ALIBABA_CLOUD_ACESS_KEY_SECRET=

# AI fraud analysis and assistant (optional) ---------------------------------
AI_API_KEY=
AI_API_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TIMEOUT=30

CHATBOT_ENABLED=false
CHATBOT_CONTEXT_TIMEOUT=600
CHATBOT_MAX_CONTEXT_ROUNDS=5
CHATBOT_RAG_ENABLED=true
CHATBOT_RAG_TOP_K=3
CHATBOT_TRIGGER_AT_ME=true
CHATBOT_TRIGGER_KEYWORDS=["反诈咨询","AI咨询","智能客服"]
CHATBOT_USE_GROUP_STATS=true
CHATBOT_STATS_CACHE_HOURS=1

# nonebot-plugin-orm -----------------------------------------------------------
SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:///data/data.db
ALEMBIC_STARTUP_CHECK=false
